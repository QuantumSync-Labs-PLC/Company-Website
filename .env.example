# EmailJS Configuration (contact forms)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
# Optional second template, sent to the enquirer as an instant acknowledgement.
# Template variables available: to_name, to_email, subject, service, message.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Booking — Google Appointment Schedule public link.
# Google Calendar > the schedule > Share > copy the booking page link, e.g.
# https://calendar.google.com/calendar/appointments/schedules/AcZssZ.../
# Leave blank and every "book a call" CTA falls back to the brief form.
VITE_BOOKING_URL=

# CRM — every enquiry is POSTed here as JSON (Zapier, Make, Google Sheets,
# HubSpot…). Optional; failures never block the form.
VITE_LEAD_WEBHOOK_URL=

# Application Environment
VITE_APP_NAME=QuantumSync Labs
# Canonical host. Must match the redirect target in vercel.json and is used for
# every canonical URL, OG tag, JSON-LD URL and the generated sitemap.
VITE_APP_URL=https://www.quantumsynclabs.com
VITE_APP_DESCRIPTION=Empowering digital transformation through innovative, secure, and scalable IT solutions.

# Analytics
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Without this, no tracking loads at all.
VITE_GA_ID=
VITE_HOTJAR_ID=

# Live chat (Crisp). Without this the chat widget never appears.
VITE_CRISP_WEBSITE_ID=

# Newsletter (Mailchimp). Without these the signup form tells visitors it is
# unavailable rather than silently discarding their address.
VITE_MAILCHIMP_FORM_ACTION=
VITE_MAILCHIMP_EMAIL_TAG=EMAIL
VITE_MAILCHIMP_NAME_TAG=

# Feature Flags
VITE_ENABLE_BLOG=true
VITE_ENABLE_CONTACT_FORM=true
